/* style.css - Fintech Payments Design System */

@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;580&family=Plus+Jakarta+Sans:wght@400;430;500;600;700&display=swap');

:root {
  /* Colors - Light Theme */
  --bg-primary: #FFFFFF;
  --bg-secondary: #F8FAFC;
  --bg-card: #FFFFFF;
  --bg-nav: rgba(255, 255, 255, 0.9);
  
  --text-primary: #0F172A; /* Secondary brand color used for text */
  --text-secondary: #475569;
  --text-inverse: #FFFFFF;
  
  --primary: #4F46E5;
  --primary-hover: #4338CA;
  
  --accent: #10B981;
  --accent-hover: #059669;

  --border: #E2E8F0;
  
  --error: #EF4444;
  --success: #10B981;

  /* Typography */
  --font-heading: 'Outfit', sans-serif;
  --font-body: 'Plus Jakarta Sans', sans-serif;
  
  --h1-size: 3.5rem;
  --h2-size: 2.5rem;
  --h3-size: 2rem;
  --h4-size: 1.5rem;
  
  --body-size: 1rem;
  --body-large: 1.125rem;
  --body-small: 0.875rem;

  --h1-weight: 580;
  --h2-weight: 540;
  --h3-weight: 500;
  
  --body-weight: 430;
  --body-weight-medium: 500;
  
  --line-height-heading: 1.15;
  --line-height-body: 1.6;

  /* Spacing */
  --spacing-1: 0.25rem; /* 4px */
  --spacing-2: 0.5rem;  /* 8px */
  --spacing-3: 0.75rem; /* 12px */
  --spacing-4: 1rem;    /* 16px */
  --spacing-6: 1.5rem;  /* 24px */
  --spacing-8: 2rem;    /* 32px */
  --spacing-12: 3rem;   /* 48px */
  --spacing-16: 4rem;   /* 64px */
  --spacing-24: 6rem;   /* 96px */

  /* Borders & Shadows */
  --radius: 12px;
  --radius-sm: 8px;
  --shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05), 0 8px 10px -6px rgba(15, 23, 42, 0.01);
  --shadow-hover: 0 20px 25px -5px rgba(15, 23, 42, 0.1), 0 8px 10px -6px rgba(15, 23, 42, 0.01);
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

[data-theme="dark"] {
  --bg-primary: #0F172A;
  --bg-secondary: #1E293B;
  --bg-card: #1E293B;
  --bg-nav: rgba(15, 23, 42, 0.9);
  
  --text-primary: #F8FAFC;
  --text-secondary: #94A3B8;
  --text-inverse: #FFFFFF;
  
  --primary: #6366F1;
  --primary-hover: #818CF8;
  
  --border: #334155;
  
  --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
  --shadow-hover: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
}

/* Base Styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: var(--font-body);
  font-weight: var(--body-weight);
  font-size: var(--body-size);
  line-height: var(--line-height-body);
  color: var(--text-primary);
  background-color: var(--bg-primary);
  transition: background-color 0.3s ease, color 0.3s ease;
  overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  line-height: var(--line-height-heading);
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

h1 { font-size: var(--h1-size); font-weight: var(--h1-weight); }
h2 { font-size: var(--h2-size); font-weight: var(--h2-weight); }
h3 { font-size: var(--h3-size); font-weight: var(--h3-weight); }
h4 { font-size: var(--h4-size); font-weight: var(--h3-weight); }

p {
  margin-bottom: var(--spacing-4);
  color: var(--text-secondary);
}

a {
  color: var(--primary);
  text-decoration: none;
  transition: var(--transition);
}

a:hover {
  color: var(--primary-hover);
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

ul, ol {
  list-style: none;
}

/* Layout Utilities */
.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--spacing-6);
}

.section {
  padding: var(--spacing-24) 0;
}

.section-bg-alt {
  background-color: var(--bg-secondary);
}

.text-center { text-align: center; }
.mt-4 { margin-top: var(--spacing-4); }
.mt-8 { margin-top: var(--spacing-8); }
.mb-4 { margin-bottom: var(--spacing-4); }
.mb-8 { margin-bottom: var(--spacing-8); }
.mb-12 { margin-bottom: var(--spacing-12); }

.grid {
  display: grid;
  gap: var(--spacing-8);
}
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

.flex {
  display: flex;
}
.flex-col {
  flex-direction: column;
}
.items-center {
  align-items: center;
}
.justify-center {
  justify-content: center;
}
.justify-between {
  justify-content: space-between;
}
.gap-4 { gap: var(--spacing-4); }
.gap-8 { gap: var(--spacing-8); }

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-3) var(--spacing-6);
  border-radius: var(--radius);
  font-family: var(--font-body);
  font-weight: var(--body-weight-medium);
  font-size: var(--body-size);
  border: none;
  cursor: pointer;
  transition: var(--transition);
  text-decoration: none;
  gap: var(--spacing-2);
}

.btn-primary {
  background-color: var(--primary);
  color: var(--text-inverse);
}
.btn-primary:hover {
  background-color: var(--primary-hover);
  color: var(--text-inverse);
  transform: translateY(-2px);
  box-shadow: var(--shadow);
}

.btn-secondary {
  background-color: transparent;
  color: var(--primary);
  border: 1px solid var(--primary);
}
.btn-secondary:hover {
  background-color: var(--primary);
  color: var(--text-inverse);
}

.btn-outline {
  background-color: transparent;
  color: var(--text-primary);
  border: 1px solid var(--border);
}
.btn-outline:hover {
  border-color: var(--text-secondary);
}

.btn-block {
  width: 100%;
}

/* Cards */
.card {
  background-color: var(--bg-card);
  border-radius: var(--radius);
  padding: var(--spacing-8);
  box-shadow: var(--shadow);
  border: 1px solid var(--border);
  transition: var(--transition);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.card:hover {
  box-shadow: var(--shadow-hover);
  transform: translateY(-4px);
}
.card-icon {
  font-size: 3rem;
  color: var(--primary);
  margin-bottom: var(--spacing-6);
}

/* Forms */
.form-group {
  margin-bottom: var(--spacing-4);
  text-align: left;
  width: 100%;
}
.form-label {
  display: block;
  margin-bottom: var(--spacing-2);
  font-weight: var(--body-weight-medium);
  font-size: var(--body-small);
}
.form-control {
  width: 100%;
  padding: var(--spacing-3) var(--spacing-4);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background-color: var(--bg-card);
  color: var(--text-primary);
  font-family: var(--font-body);
  font-size: var(--body-size);
  transition: var(--transition);
}
.form-control:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
}
.form-control.error {
  border-color: var(--error);
}
.form-control.success {
  border-color: var(--success);
}
.error-msg {
  color: var(--error);
  font-size: 0.8rem;
  margin-top: var(--spacing-1);
  display: none;
}
.checkbox-group {
  display: flex;
  align-items: center;
  gap: var(--spacing-2);
}
.checkbox-group input {
  width: 16px;
  height: 16px;
  cursor: pointer;
}

/* Navbar */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background-color: var(--bg-nav);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  transition: var(--transition);
}
.nav-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80px;
}
.nav-logo {
  font-family: var(--font-heading);
  font-weight: var(--h1-weight);
  font-size: 1.5rem;
  color: var(--text-primary);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: var(--spacing-2);
}
.nav-logo i {
  color: var(--primary);
  font-size: 2rem;
}
.nav-links {
  display: flex;
  align-items: center;
  gap: var(--spacing-8);
}
.nav-link {
  color: var(--text-secondary);
  font-weight: var(--body-weight-medium);
  transition: var(--transition);
}
.nav-link:hover, .nav-link.active {
  color: var(--primary);
}
.nav-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-4);
}
.theme-toggle {
  background: none;
  border: none;
  color: var(--text-secondary);
  font-size: 1.5rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-2);
  border-radius: 50%;
  transition: var(--transition);
}
.theme-toggle:hover {
  background-color: var(--bg-secondary);
  color: var(--text-primary);
}

/* Hamburger */
.hamburger {
  display: none;
  background: none;
  border: none;
  color: var(--text-primary);
  font-size: 2rem;
  cursor: pointer;
}

/* Mobile Drawer */
.drawer-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 1001;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.drawer-overlay.active {
  display: block;
  opacity: 1;
}
.drawer-menu {
  position: fixed;
  top: 0;
  right: -100%;
  width: 300px;
  height: 100vh;
  background-color: var(--bg-primary);
  z-index: 1002;
  padding: var(--spacing-8) var(--spacing-6);
  transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-hover);
}
.drawer-menu.active {
  right: 0;
}
.drawer-close {
  align-self: flex-end;
  background: none;
  border: none;
  color: var(--text-primary);
  font-size: 2rem;
  cursor: pointer;
  margin-bottom: var(--spacing-8);
}
.drawer-nav-links {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4);
}
.drawer-nav-link {
  font-size: 1.25rem;
  color: var(--text-primary);
  text-decoration: none;
  font-weight: var(--body-weight-medium);
  padding: var(--spacing-3) 0;
  border-bottom: 1px solid var(--border);
  display: block;
}
.drawer-actions {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4);
}
.drawer-theme {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-3) 0;
  border-bottom: 1px solid var(--border);
  color: var(--text-primary);
  font-weight: var(--body-weight-medium);
}

/* Footer */
.footer {
  background-color: var(--bg-secondary);
  padding: var(--spacing-16) 0 var(--spacing-8);
  border-top: 1px solid var(--border);
}
.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: var(--spacing-8);
  margin-bottom: var(--spacing-12);
}
.footer-logo {
  font-family: var(--font-heading);
  font-weight: var(--h1-weight);
  font-size: 1.5rem;
  color: var(--text-primary);
  margin-bottom: var(--spacing-4);
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-2);
}
.footer-logo i { color: var(--primary); }
.footer h4 {
  margin-bottom: var(--spacing-4);
  font-size: 1.125rem;
}
.footer-links {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-3);
}
.footer-link {
  color: var(--text-secondary);
}
.footer-link:hover {
  color: var(--primary);
}
.footer-bottom {
  text-align: center;
  padding-top: var(--spacing-8);
  border-top: 1px solid var(--border);
}
.footer-disclosure {
  font-size: var(--body-small);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-4);
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

/* Animations (Hero & general) */
.animate-fade-in {
  opacity: 0;
  animation: fadeIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) both;
  will-change: transform, opacity;
}
.animate-slide-up {
  opacity: 0;
  transform: translateY(20px);
  animation: slideUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) both;
  will-change: transform, opacity;
}
.delay-100 { animation-delay: 0.1s; }
.delay-200 { animation-delay: 0.2s; }
.delay-300 { animation-delay: 0.3s; }

@keyframes fadeIn {
  to { opacity: 1; }
}
@keyframes slideUp {
  to { opacity: 1; transform: translateY(0); }
}

/* Auth Layout */
.auth-layout {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-6);
  background-color: var(--bg-secondary);
}
.auth-container {
  width: 100%;
  max-width: 480px;
  background-color: var(--bg-card);
  padding: var(--spacing-12) var(--spacing-8);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  border: 1px solid var(--border);
}
.auth-header {
  text-align: center;
  margin-bottom: var(--spacing-8);
}
.auth-logo {
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-2);
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: var(--h1-weight);
  color: var(--text-primary);
  margin-bottom: var(--spacing-6);
}
.auth-logo i { color: var(--primary); font-size: 2rem; }
.auth-divider {
  display: flex;
  align-items: center;
  text-align: center;
  margin: var(--spacing-6) 0;
}
.auth-divider::before, .auth-divider::after {
  content: '';
  flex: 1;
  border-bottom: 1px solid var(--border);
}
.auth-divider span {
  padding: 0 var(--spacing-4);
  color: var(--text-secondary);
  font-size: var(--body-small);
}

/* Trust Badges */
.trust-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-2);
  padding: var(--spacing-2) var(--spacing-4);
  background-color: rgba(16, 185, 129, 0.1);
  color: var(--accent);
  border-radius: 20px;
  font-size: var(--body-small);
  font-weight: var(--body-weight-medium);
}
.secure-notice {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-2);
  color: var(--text-secondary);
  font-size: var(--body-small);
  margin-top: var(--spacing-4);
}
.secure-notice i { color: var(--accent); }

/* Responsive Breakpoints */
@media (max-width: 1439px) {
  /* Large Desktop */
}

@media (max-width: 1024px) {
  /* Tablet+Mobile — hamburger starts */
  .nav-links, .nav-actions {
    display: none;
  }
  .hamburger {
    display: block;
  }
  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  /* Mobile */
  :root {
    --h1-size: 2.5rem;
    --h2-size: 2rem;
    --h3-size: 1.5rem;
    --spacing-24: 4rem;
  }
  .grid-2, .grid-3, .grid-4 {
    grid-template-columns: 1fr;
  }
  .footer-grid {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .footer-links {
    align-items: center;
  }
  .footer-logo {
    justify-content: center;
  }
  .hero-flex {
    flex-direction: column;
    text-align: center;
  }
  .hero-flex .btn-group {
    justify-content: center;
  }
}

@media (max-width: 360px) {
  /* Small Mobile */
  .container {
    padding: 0 var(--spacing-4);
  }
  .drawer-menu {
    width: 100%;
  }
  .btn {
    width: 100%;
    margin-bottom: var(--spacing-2);
  }
  .btn-group {
    flex-direction: column;
  }
  .contact-wrapper {
    width: 100%;
    overflow: hidden;
  }
}

/* Utilities for Hero Section */
.hero {
  padding-top: 140px;
  padding-bottom: var(--spacing-24);
  position: relative;
  overflow: hidden;
}
.hero-content {
  max-width: 600px;
}
.hero-image img {
  border-radius: var(--radius);
  box-shadow: var(--shadow-hover);
}
.hero-badge {
  display: inline-block;
  padding: var(--spacing-1) var(--spacing-3);
  background-color: rgba(79, 70, 229, 0.1);
  color: var(--primary);
  border-radius: 20px;
  font-size: var(--body-small);
  font-weight: var(--body-weight-medium);
  margin-bottom: var(--spacing-6);
}
.btn-group {
  display: flex;
  gap: var(--spacing-4);
  flex-wrap: wrap;
}

/* Pricing Table */
.pricing-card {
  position: relative;
}
.pricing-card.featured {
  border-color: var(--primary);
  box-shadow: 0 0 0 2px var(--primary);
}
.pricing-badge {
  position: absolute;
  top: -12px;
  background-color: var(--primary);
  color: var(--text-inverse);
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: bold;
}
.pricing-price {
  font-size: 3rem;
  font-weight: var(--h1-weight);
  color: var(--text-primary);
  margin: var(--spacing-6) 0;
}
.pricing-features {
  text-align: left;
  width: 100%;
  margin: var(--spacing-6) 0;
}
.pricing-features li {
  display: flex;
  align-items: center;
  gap: var(--spacing-3);
  margin-bottom: var(--spacing-3);
}
.pricing-features i {
  color: var(--success);
}
